{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/**/*.js",
    "server/**/*.mjs",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist-v2",
    "github-upload-*"
  ]
}
